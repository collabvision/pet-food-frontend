# The ONLY backend detail ever shipped to the browser. Point this at your
# Express API's versioned base path.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Must match the cookie name your backend sets for the httpOnly refresh
# token (see README "Backend cookie contract"). Used only by middleware.js
# on the server/edge to decide whether to show or hide the auth pages — it
# never reads the cookie's value.
REFRESH_COOKIE_NAME=refreshToken
